<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Culture-sensitive string APIs must be explicit; rules parity depends on ordinal behaviour. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1720;CA1711;CA1062;CA1303;CA2007;CA1031;CA1819;CA1002;CA1034;CA1024</NoWarn>
  </PropertyGroup>
</Project>
